# Copy to .env.local (or set in Vercel → Project → Settings → Environment Variables).
# All values are public (NEXT_PUBLIC_*). Never put private keys or secrets here.
# Every variable is optional — the defaults below are built in.

# Launchpad API. Defaults to this app's own chain-backed API (/api/arena).
# Point it at the round bot's backend once that exists.
# Endpoints are documented in src/lib/data/apiSource.ts.
NEXT_PUBLIC_LAUNCHPAD_API_URL=

# Network — Robinhood Chain mainnet (https://docs.robinhood.com/chain/connecting).
# Testnet: chain id 46630, rpc https://rpc.testnet.chain.robinhood.com,
# explorer https://explorer.testnet.chain.robinhood.com
NEXT_PUBLIC_NETWORK_NAME=Robinhood Chain
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_EXPLORER_URL=https://robinhoodchain.blockscout.com

# Token page on the source launchpad. {address} is replaced with the token address.
NEXT_PUBLIC_TRADE_URL_TEMPLATE=https://www.ponsfamily.com/launchpad/{address}

# Launchpad contract tokens are created through (Robinhood Chain mainnet).
# Launch config / DEX ids default to the launchpad defaults (0 and 0).
NEXT_PUBLIC_LAUNCHPAD_CONTRACT=0xf4fc0cd27fc8ecf17e55ee4c3f7201897df3eb75
# The arena only lists tokens launched from this site, recognised by the marker
# in their launch salt. Launches before this block are never scanned.
NEXT_PUBLIC_ARENA_FROM_BLOCK=69964144
NEXT_PUBLIC_LAUNCH_CONFIG_ID=0
NEXT_PUBLIC_LAUNCH_DEX_ID=0

# Image uploads on /launch. Create a Blob store in the Vercel project
# (Storage → Create → Blob) and this variable is added automatically.
# Without it the form falls back to pasting an image link.
BLOB_READ_WRITE_TOKEN=

# Token images stored on IPFS. The gateway is used by the browser; the server
# falls back to IPFS_GATEWAYS (comma separated) through /api/ipfs.
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.filebase.io/ipfs/
IPFS_GATEWAYS=

# How many tokens the arena ranks (default 100).
ARENA_BOARD_SIZE=
