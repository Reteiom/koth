# Copy to .env.local (or set in Vercel → Project → Settings → Environment Variables).
# All values are public (NEXT_PUBLIC_*). Never put private keys or secrets here.
# Every variable is optional — the defaults below are built in.

# Data source: "mock" (default, labelled "Demo data" in the UI) or "api".
NEXT_PUBLIC_DATA_SOURCE=mock

# Launchpad backend base URL, used when NEXT_PUBLIC_DATA_SOURCE=api.
# Endpoints are documented in src/lib/data/apiSource.ts.
NEXT_PUBLIC_LAUNCHPAD_API_URL=

# Network — Robinhood Chain mainnet (https://docs.robinhood.com/chain/connecting).
# Testnet: chain id 46630, rpc https://rpc.testnet.chain.robinhood.com,
# explorer https://explorer.testnet.chain.robinhood.com
NEXT_PUBLIC_NETWORK_NAME=Robinhood Chain
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_EXPLORER_URL=https://robinhoodchain.blockscout.com

# Token page on the source launchpad. {address} is replaced with the token address.
NEXT_PUBLIC_TRADE_URL_TEMPLATE=https://www.ponsfamily.com/launchpad/{address}

# Set to "true" once lib/launch.ts is wired to the launch contract.
NEXT_PUBLIC_LAUNCH_ENABLED=false
